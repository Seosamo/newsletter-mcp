# Local configuration for Chat Newsletter MCP.
# Fill in secrets locally. This file is ignored by git.

# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
MCP_ENDPOINT_PATH=/mcp
PUBLIC_BASE_URL=
ALLOWED_ORIGINS=
NEWSLETTER_MCP_AUTH_TOKEN=
NEWSLETTER_MCP_DATA_DIR=

# Provider toggles
ENABLE_DOMAIN_CONNECTORS=true
ENABLE_MOCK_PROVIDERS=true

# Public API domain connectors
DOMAIN_CONNECTOR_MAX_CONNECTORS=3
DOMAIN_CONNECTOR_TIMEOUT_MS=8000
TOUR_API_KEY=
TOUR_API_BASE_URL=
CULTURE_INFO_API_URL=
CULTURE_INFO_API_KEY=
EVENTBRITE_TOKEN=
EVENTBRITE_API_URL=
TICKETMASTER_API_KEY=
TICKETMASTER_API_URL=
KMA_API_URL=
KMA_API_KEY=
OPENAQ_API_KEY=
OPENAQ_API_URL=

# Web search provider selection: all | tavily | external_mcp | noapi_google_search | none
WEB_SEARCH_PROVIDER=all
ENABLE_WEB_SEARCH=false
ENABLE_TAVILY_SEARCH=false
WEB_SEARCH_MAX_RESULTS=6
WEB_SEARCH_MAX_PAGES_TO_EXTRACT=3
WEB_SEARCH_TIMEOUT_MS=8000
WEB_SEARCH_EXTRACT_HTML=true
WEB_SEARCH_ALLOWED_DOMAINS=
WEB_SEARCH_BLOCKED_DOMAINS=
WEB_SEARCH_PAGE_CHUNK_MAX_CHARS=1800
WEB_SEARCH_PAGE_CHUNK_OVERLAP_CHARS=200
WEB_SEARCH_MAX_SELECTED_CHUNKS_PER_PAGE=2
WEB_SEARCH_MAX_SELECTED_CHUNKS_TOTAL=8

# Tavily search
TAVILY_API_KEY=
TAVILY_SEARCH_API_URL=https://api.tavily.com/search
TAVILY_SEARCH_TOPIC=general
TAVILY_SEARCH_DEPTH=basic
TAVILY_INCLUDE_RAW_CONTENT=false

# HTML extraction
HTML_EXTRACT_TIMEOUT_MS=8000
HTML_EXTRACT_MAX_TEXT_CHARS=5000

# External MCP search provider
ENABLE_EXTERNAL_MCP_SEARCH=false
EXTERNAL_MCP_SEARCH_COMMAND=
EXTERNAL_MCP_SEARCH_ARGS=
EXTERNAL_MCP_SEARCH_CWD=
EXTERNAL_MCP_SEARCH_TOOL_NAME=search
EXTERNAL_MCP_SEARCH_QUERY_PARAM=query
EXTERNAL_MCP_SEARCH_MAX_RESULTS_PARAM=maxResults
EXTERNAL_MCP_SEARCH_REGION_PARAM=
EXTERNAL_MCP_SEARCH_MAX_RESULTS=6
EXTERNAL_MCP_SEARCH_TIMEOUT_MS=30000

# noapi-google-search MCP aliases
ENABLE_NOAPI_GOOGLE_SEARCH=false
NOAPI_GOOGLE_SEARCH_COMMAND=python
NOAPI_GOOGLE_SEARCH_ARGS=-m pipx run noapi-google-search-mcp
NOAPI_GOOGLE_SEARCH_CWD=
NOAPI_GOOGLE_SEARCH_TOOL_NAME=google_search
NOAPI_GOOGLE_SEARCH_QUERY_PARAM=query
NOAPI_GOOGLE_SEARCH_MAX_RESULTS_PARAM=num_results
NOAPI_GOOGLE_SEARCH_REGION_PARAM=region
NOAPI_GOOGLE_SEARCH_VISIT_PAGES=true
NOAPI_GOOGLE_SEARCH_VISIT_PAGE_TOOL_NAME=visit_page
NOAPI_GOOGLE_SEARCH_VISIT_PAGE_URL_PARAM=url
NOAPI_GOOGLE_SEARCH_MAX_PAGES_TO_VISIT=3
NOAPI_GOOGLE_SEARCH_PAGE_CHUNK_MAX_CHARS=1800
NOAPI_GOOGLE_SEARCH_PAGE_CHUNK_OVERLAP_CHARS=200
NOAPI_GOOGLE_SEARCH_MAX_SELECTED_CHUNKS_PER_PAGE=2
NOAPI_GOOGLE_SEARCH_MAX_SELECTED_CHUNKS_TOTAL=8

# Live comparison test
RUN_SEARCH_COMPARISON=true
SEARCH_COMPARISON_QUERY=latest Japan anime news
SEARCH_COMPARISON_EXCLUDED_KEYWORDS=
SEARCH_COMPARISON_START=
SEARCH_COMPARISON_END=
SEARCH_COMPARISON_MAX_RESULTS=8
SEARCH_COMPARISON_EXTRACT_HTML=false


DATABASE_URL="postgresql://neondb_owner:npg_ok3wyqhaH2WA@ep-summer-king-ao0l6nwf.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_SSL=require
